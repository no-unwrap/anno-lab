# Backend
# Keep only one real credential set per local env file.
# For safer local separation, create ignored files such as `.env.personal` and `.env.ivc`
# from this template, then select them explicitly for host-shell runs with:
# `ANNO_LAB_ENV_FILE=.env.personal python backend/manage.py ...`
# Compose can use the same profile files with:
# `docker compose --env-file .env.personal up -d`
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_WRITE_TOKEN=dev-write-token

# Database
POSTGRES_DB=anno_lab
POSTGRES_USER=anno_lab
POSTGRES_PASSWORD=anno_lab
# Docker Compose service hostname. Override with localhost for host-shell DB-backed
# manage.py commands that connect through the published Postgres port.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# AWS / MTurk
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
MTURK_SANDBOX=1
MTURK_WORKER_QUEUE_URL=

# Public base URL used for MTurk ExternalQuestion links
PUBLIC_BASE_URL=http://localhost:8000
