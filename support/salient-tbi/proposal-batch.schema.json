{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anno-lab.local/support/salient-tbi/proposal-batch.schema.json",
  "title": "Salient TBI Seed Proposal Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_type",
    "provider",
    "checkpoint",
    "run_id",
    "proposals"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "task_type": {
      "const": "salient_tbi"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "proposal_id",
          "score",
          "polygon"
        ],
        "properties": {
          "task_id": {
            "type": "integer",
            "minimum": 1
          },
          "proposal_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number"
          },
          "polygon": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  }
}
